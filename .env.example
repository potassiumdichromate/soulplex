# Copy to .env for the production compose file; never commit it.
# Local runs keep data in a SQLite file. Production compose uses Postgres.
DOMAIN=soulplex.your-domain.example
APP_ORIGIN=https://soulplex.your-domain.example
# Use a long random alphanumeric password (avoids URL encoding issues).
POSTGRES_PASSWORD=replace_with_random_48_character_password
# Required for live verification and recovery. Configure a real delivery domain.
SMTP_HOST=
SMTP_FROM=accounts@your-domain.example
SMTP_USERNAME=
SMTP_PASSWORD=

# Model provider: openai (default) or 0g (pc.0g.ai Router, OpenAI-compatible).
AI_PROVIDER=openai
# OpenAI or 0G inference key (sk-...). Live mode also uses it for safety screening.
AI_API_KEY=
# Chat model id. For 0G, pick one from GET https://router-api.0g.ai/v1/models.
AI_MODEL=
# 0G only: private (default, TEE + zero retention) | verified | standard
# AI_0G_TRUST_MODE=private
# 0G has no moderation endpoint, so the model screens content. Optional cheaper model for that:
# MODERATION_LLM_MODEL=
# Or keep OpenAI's moderation endpoint by setting an OpenAI key here:
# MODERATION_API_KEY=
# Hello Minds. Server secret only. Never put it in frontend code.
# Create it in the Builder console (shown once): https://build.hellominds.ai
MINDS_BUILDER_API_KEY=
# Archetype for a new agent. Examples: mastermind, gtm.
MINDS_MIND_TYPE=mastermind
# Optional tuning. Defaults shown. See docs/HELLO_MINDS.md.
# MINDS_API_BASE=https://api.build.hellominds.ai
# MINDS_LANGUAGE=en
# MINDS_SSE=1                  # listen on the event stream; history polling stays as fallback
# MINDS_SYNC_DELAY=60          # seconds after the last profile or fact change before the persona is re-sent
# MINDS_MAX_CONCURRENCY=8      # calls in flight per process
# MINDS_MAX_STREAMS=16         # event streams open per process
# MINDS_MAX_RETRIES=3          # 429 everywhere, 502/503/504 on reads, 409 on send
# MINDS_BREAKER_THRESHOLD=5    # failures before the circuit opens
# MINDS_BREAKER_COOLDOWN=30    # seconds the circuit stays open
# MINDS_MIN_COGNITION=1        # below this, a date falls back to AI_MODEL or stops with a clear error
# MINDS_JUDGE=0                # 1 = a shared judge Mind also scores dates (it reads both people's facts)
# MINDS_ALLOWED_SKILLS=        # comma-separated Bazaar skill ids members may equip; empty = none
# A connection is offered only when the date score reaches this (0-100).
MATCH_SCORE_MIN=70